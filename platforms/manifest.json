{
  "schemaVersion": 1,
  "lastReviewed": "2026-07-21",
  "installPolicy": {
    "scope": "user",
    "portableDefault": "symlink",
    "generatedDefault": "copy",
    "copyFlag": "--copy",
    "writes": "staged-no-clobber",
    "conflicts": "preserve-user-owned"
  },
  "platforms": [
    {
      "id": "cursor",
      "product": "Cursor",
      "surface": "Cursor editor and CLI",
      "supportTier": "preview",
      "lastVerified": "2026-07-21",
      "detection": {
        "userPath": ".cursor"
      },
      "capabilities": {
        "instructions": {
          "supported": true,
          "strategy": "files",
          "format": "cursor-rule",
          "userPath": ".cursor/rules",
          "projectPath": ".cursor/rules",
          "extension": ".mdc",
          "precedence": "Project rules can be more specific; user rules configured in the product UI also apply."
        },
        "skills": {
          "supported": true,
          "strategy": "directories",
          "format": "agent-skill",
          "userPath": ".cursor/skills",
          "projectPath": ".cursor/skills",
          "fileName": "SKILL.md",
          "precedence": "Project skills can override user skills with the same name."
        },
        "agents": {
          "supported": true,
          "strategy": "files",
          "format": "markdown-agent",
          "userPath": ".cursor/agents",
          "projectPath": ".cursor/agents",
          "extension": ".md",
          "precedence": "Project agents can specialize a repository; user agents remain available globally."
        }
      },
      "legacyDestinations": [
        {
          "category": "skills",
          "userPath": ".cursor/skills-cursor",
          "layout": "nested",
          "fileName": "SKILL.md",
          "sourceRoot": "skills",
          "reason": "Reserved Cursor-managed skill directory used by older installer versions."
        }
      ],
      "documentation": [
        "https://cursor.com/docs/rules",
        "https://cursor.com/docs/skills",
        "https://cursor.com/changelog/2-4"
      ]
    },
    {
      "id": "claude",
      "product": "Claude Code",
      "surface": "Claude Code CLI",
      "supportTier": "verified",
      "lastVerified": "2026-07-21",
      "detection": {
        "userPath": ".claude"
      },
      "capabilities": {
        "instructions": {
          "supported": true,
          "strategy": "files",
          "format": "markdown",
          "userPath": ".claude/rules",
          "projectPath": ".claude/rules",
          "extension": ".md",
          "precedence": "More specific project instructions supplement user-level rules."
        },
        "skills": {
          "supported": true,
          "strategy": "directories",
          "format": "agent-skill",
          "userPath": ".claude/skills",
          "projectPath": ".claude/skills",
          "fileName": "SKILL.md",
          "precedence": "Enterprise skills override personal skills, which override project skills."
        },
        "agents": {
          "supported": true,
          "strategy": "files",
          "format": "markdown-agent",
          "userPath": ".claude/agents",
          "projectPath": ".claude/agents",
          "extension": ".md",
          "precedence": "Project agents take precedence over user agents with the same name."
        }
      },
      "legacyDestinations": [],
      "documentation": [
        "https://code.claude.com/docs/en/memory",
        "https://code.claude.com/docs/en/skills",
        "https://code.claude.com/docs/en/sub-agents"
      ]
    },
    {
      "id": "codex",
      "product": "Codex",
      "surface": "Codex app, CLI, and IDE extension",
      "supportTier": "verified",
      "lastVerified": "2026-07-21",
      "detection": {
        "userPath": ".codex"
      },
      "capabilities": {
        "instructions": {
          "supported": true,
          "strategy": "concat",
          "format": "agents-md",
          "userPath": ".codex/AGENTS.md",
          "projectPath": "AGENTS.md",
          "precedence": "AGENTS.override.md takes precedence over AGENTS.md at the same level.",
          "blockingPath": ".codex/AGENTS.override.md"
        },
        "skills": {
          "supported": true,
          "strategy": "directories",
          "format": "agent-skill",
          "userPath": ".agents/skills",
          "projectPath": ".agents/skills",
          "fileName": "SKILL.md",
          "precedence": "Repository and user skills with duplicate names remain distinct."
        },
        "agents": {
          "supported": true,
          "strategy": "files",
          "format": "codex-agent-toml",
          "userPath": ".codex/agents",
          "projectPath": ".codex/agents",
          "extension": ".toml",
          "precedence": "A custom agent with a built-in name takes precedence over the built-in agent."
        }
      },
      "legacyDestinations": [
        {
          "category": "instructions",
          "userPath": ".codex/instructions",
          "layout": "flat",
          "sourceRoot": "instructions",
          "reason": "legacy Codex instructions from the former per-file layout."
        }
      ],
      "documentation": [
        "https://developers.openai.com/codex/guides/agents-md",
        "https://developers.openai.com/codex/skills",
        "https://developers.openai.com/codex/subagents"
      ]
    },
    {
      "id": "copilot",
      "product": "GitHub Copilot CLI",
      "surface": "GitHub Copilot CLI",
      "supportTier": "verified",
      "lastVerified": "2026-07-21",
      "detection": {
        "userPath": ".copilot"
      },
      "capabilities": {
        "instructions": {
          "supported": true,
          "strategy": "concat",
          "format": "copilot-instructions",
          "userPath": ".copilot/copilot-instructions.md",
          "projectPath": ".github/copilot-instructions.md",
          "precedence": "Applicable user and repository instruction files are merged; avoid conflicting guidance."
        },
        "skills": {
          "supported": true,
          "strategy": "directories",
          "format": "agent-skill",
          "userPath": ".copilot/skills",
          "projectPath": ".github/skills",
          "fileName": "SKILL.md",
          "precedence": "The first discovered skill wins for duplicate names."
        },
        "agents": {
          "supported": true,
          "strategy": "files",
          "format": "markdown-agent",
          "userPath": ".copilot/agents",
          "projectPath": ".github/agents",
          "extension": ".agent.md",
          "precedence": "User agents take precedence over repository agents with the same name in Copilot CLI."
        }
      },
      "legacyDestinations": [],
      "documentation": [
        "https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/add-custom-instructions",
        "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-command-reference",
        "https://docs.github.com/en/copilot/how-tos/copilot-cli/customize-copilot/create-custom-agents-for-cli"
      ]
    },
    {
      "id": "gemini",
      "product": "Gemini CLI",
      "surface": "Gemini CLI",
      "supportTier": "verified",
      "lastVerified": "2026-07-21",
      "detection": {
        "userPath": ".gemini"
      },
      "capabilities": {
        "instructions": {
          "supported": true,
          "strategy": "concat",
          "format": "gemini-md",
          "userPath": ".gemini/GEMINI.md",
          "projectPath": "GEMINI.md",
          "precedence": "Global, workspace, and just-in-time context files are concatenated."
        },
        "skills": {
          "supported": true,
          "strategy": "directories",
          "format": "agent-skill",
          "userPath": ".gemini/skills",
          "projectPath": ".gemini/skills",
          "fileName": "SKILL.md",
          "precedence": "Workspace skills override user skills with the same name."
        },
        "agents": {
          "supported": true,
          "strategy": "files",
          "format": "markdown-agent",
          "userPath": ".gemini/agents",
          "projectPath": ".gemini/agents",
          "extension": ".md",
          "precedence": "Workspace agents can be reloaded independently from user agents."
        }
      },
      "legacyDestinations": [],
      "documentation": [
        "https://geminicli.com/docs/cli/gemini-md/",
        "https://geminicli.com/docs/cli/using-agent-skills/",
        "https://geminicli.com/docs/core/subagents/"
      ]
    }
  ]
}
